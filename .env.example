# ── App ───────────────────────────────────────────────────────
# Ambiente: define qual bloco de config/config.js e usado (DEV_DB_* x PROD_DB_*)
NODE_ENV=development
PORT=3030

# ── Banco de dados – Development (local) ──────────────────────
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=3306
DEV_DB_NAME=cicatribiovet_local
DEV_DB_USER=root
DEV_DB_PASS=

# ── Banco de dados – Production ───────────────────────────────
PROD_DB_HOST=
PROD_DB_PORT=
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASS=

# ── AWS S3 ────────────────────────────────────────────────────
AWS_BUCKET_NAME_VALUE=seu-bucket-aqui
AWS_BUCKET_REGION_VALUE=us-east-2
AWS_ACCESS_KEY_VALUE=sua-access-key-aqui
AWS_SECRET_KEY_VALUE=sua-secret-key-aqui

# ── Stripe ────────────────────────────────────────────────────
# Modo teste: chaves sk_test_/whsec_
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price recorrente do plano de assinatura do SaaS (criado no Dashboard Stripe)
STRIPE_PRICE_ID=price_xxx
# Pais padrao das contas Connect Express dos veterinarios
STRIPE_CONNECT_DEFAULT_COUNTRY=BR
# URL do frontend usada nos redirects de sucesso/cancelamento/retorno do Stripe
WEB_APP_URL=http://localhost:3000

# ── URLs do frontend ──────────────────────────────────────────
# Usada nos links de verificacao de prescricoes
FRONTEND_URL=http://localhost:3000
# Usada no link de reset de senha
CLIENT_URL=http://localhost:3000

# ── E-mail / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@dominio.com
SMTP_PASS=sua-senha-smtp
# Remetente exibido (opcional; default usa SMTP_USER)
SMTP_FROM="Meu Bixin" <seu-email@dominio.com>
